name: Build Windows exe

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Configure
        run: cmake -B build -DCMAKE_BUILD_TYPE=Release
      - name: Build
        run: cmake --build build --config Release
      - name: Run logic tests
        run: build\Release\sim_test.exe
      - name: Upload game
        uses: actions/upload-artifact@v4
        with:
          name: aimtrainer-windows
          path: |
            build/Release/aimtrainer.exe
            build/Release/config.ini
            build/Release/maps
            build/Release/sounds
            build/Release/models
            build/Release/sky
